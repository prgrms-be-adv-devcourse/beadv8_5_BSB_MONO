# 로컬 k3d 앱의 비밀값 (Secret app-secret). 이 파일을 secret.yaml로 복사해 값을 채운다. secret.yaml은 git에 올라가지 않는다
#   cp k8s/overlays/local/secret.yaml.example k8s/overlays/local/secret.yaml
# 값은 backend/.env의 같은 키에서 가져온다. 키 설명은 backend/.env.example에 있다
#
# 여기에는 비밀값만 둔다. 인프라 주소·프로파일 같은 비밀이 아닌 설정은 k8s/base/app-config.yaml(ConfigMap)에 있다
# 로컬에서 쓰지 않는 운영 키(실제 AWS 키, 운영 Slack 주소 등)는 넣지 않는다. 운영 비밀값은 SSM Parameter Store에 둔다
#
# stringData에는 원래 값을 그대로 쓴다 (k8s가 저장할 때 base64로 바꾼다). 값은 작은따옴표로 감싼다
# 쓰지 않는 키는 주석으로 둔다. 빈 값('')으로 두면 앱 설정의 기본값 대신 빈 문자열이 들어가 앱이 뜨지 않을 수 있다
#
# 값을 바꿔 apply해도 떠 있는 Pod는 옛 값을 쓴다. 바꾼 뒤에는 다시 띄운다
#   kubectl rollout restart -n crewrun deploy
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: crewrun
type: Opaque
stringData:
  # 앱이 prod 프로파일로 뜨므로 아래 값은 꼭 채운다
  # DB 계정 (로컬은 backend/compose.yml의 bukang-db MYSQL_USER·MYSQL_PASSWORD와 같은 값)
  MYSQL_USER: ''
  MYSQL_PASS: ''
  # 토큰 서명 (32자 이상, openssl rand -base64 32)
  JWT_SECRET: ''
  # 민감정보 암호화 (member-service, cash-service)
  CRYPTO_HMAC_KEY: ''
  CRYPTO_PASSWORD: ''
  CRYPTO_SALT: ''

  # 앱 설정에 기본값이 없어 키가 꼭 있어야 한다. 로컬은 빈 값으로 둔다
  # (토스 결제 승인 키: 비우면 결제 승인만 실패한다. Elasticsearch 계정: 로컬은 보안이 꺼져 있다)
  TOSS_SECRET_KEY: ''
  ELASTICSEARCH_USERNAME: ''
  ELASTICSEARCH_PASSWORD: ''

  # 로컬은 S3Mock이라 실제 AWS 키를 넣지 않는다 (아래 가짜 값 그대로 둔다)
  S3_ACCESS_KEY: 's3mock'
  S3_SECRET_KEY: 's3mock'

  # 아래는 그 기능을 확인할 때만 주석을 풀고 채운다. 비워 두면 그 기능만 꺼지거나 실패하고 앱은 뜬다
  # IDENTITY_CI_HASH_KEY: ''
  # MARKETING_UNSUBSCRIBE_KEY: ''
  # 소셜 로그인 (member-service)
  # OAUTH2_KAKAO_CLIENT_ID: ''
  # OAUTH2_KAKAO_CLIENT_SECRET: ''
  # OAUTH2_KAKAO_ADMIN_KEY: ''
  # OAUTH2_GOOGLE_CLIENT_ID: ''
  # OAUTH2_GOOGLE_CLIENT_SECRET: ''
  # 결제·본인인증·계좌 (cash-service, member-service, payout-service)
  # PORTONE_API_SECRET: ''
  # OPENBANKING_CLIENT_ID: ''
  # OPENBANKING_CLIENT_SECRET: ''
  # 외부 API (order-service 배송 조회, ai-service, notification-service 메일)
  # DELIVERY_TRACKER_CLIENT_ID: ''
  # DELIVERY_TRACKER_CLIENT_SECRET: ''
  # OPENAI_API_KEY: ''
  # MAIL_USERNAME: ''
  # MAIL_PASSWORD: ''
  # Kafka 처리 실패 알림 Slack Webhook. 로컬은 쓰지 않는다 (채우면 로컬 실패도 팀 채널에 올라간다)
  # SLACK_WEBHOOK_URL: ''
  # 어드민 이용 통계 (web만 읽는다)
  # GA4_PROPERTY_ID: ''
  # GA4_SERVICE_ACCOUNT_KEY: ''
