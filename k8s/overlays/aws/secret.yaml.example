# 운영(AWS k3s) 앱의 비밀값 (Secret app-secret). 키 목록만 커밋하고 값은 두지 않는다
#   실제 값은 SSM Parameter Store의 /crewrun/prod/<키 이름> (SecureString)에 둔다
#   메인 EC2의 infra/main-node/deploy.sh가 배포할 때 이 파일의 키 목록대로 Parameter Store에서 값을 읽어
#   secret.yaml을 만들고, 적용한 뒤 지운다. 그래서 이 파일을 손으로 복사해 쓰지 않는다
#   키를 더하거나 빼면 Parameter Store와 이 목록을 함께 고친다
#   Parameter Store에 없는 키는 빈 값으로 들어간다. 단 아래 「꼭 채움」 키가 비면 deploy.sh가 배포를 멈춘다
#
# 비밀이 아닌 값(주소, 앱 ID, 버킷 이름 등)은 app-config.yaml에 있다. 두 곳에 같은 키를 두지 않는다
# 값은 운영 메인 EC2의 backend/.env(2026-11-15)에서 옮긴다
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: crewrun
type: Opaque
stringData:
  # 꼭 채움: 아래 6개가 비면 앱이 뜨지 않거나 데이터를 읽지 못해 deploy.sh가 배포를 멈춘다
  # DB 계정 (보조 EC2 infra/data-node/.env의 MYSQL_USER·MYSQL_PASSWORD와 같은 값)
  MYSQL_USER: ''
  MYSQL_PASS: ''

  # 토큰 서명·민감정보 암호화. 바꾸면 기존 로그인·암호화된 데이터를 읽지 못한다 (JWT_SECRET, CRYPTO_* 3개는 꼭 채움)
  JWT_SECRET: ''
  CRYPTO_HMAC_KEY: ''
  CRYPTO_PASSWORD: ''
  CRYPTO_SALT: ''
  IDENTITY_CI_HASH_KEY: ''

  # S3 (IAM 사용자 키. 나중에 EC2 역할로 바꾸면 두 키를 지운다)
  S3_ACCESS_KEY: ''
  S3_SECRET_KEY: ''

  # 결제·본인인증
  TOSS_SECRET_KEY: ''
  PORTONE_API_SECRET: ''

  # 소셜 로그인 (앱 ID는 app-config.yaml)
  OAUTH2_KAKAO_CLIENT_SECRET: ''
  OAUTH2_KAKAO_ADMIN_KEY: ''
  OAUTH2_GOOGLE_CLIENT_SECRET: ''

  # 배송 조회 API (서버끼리만 쓰는 ID와 비밀 키)
  DELIVERY_TRACKER_CLIENT_ID: ''
  DELIVERY_TRACKER_CLIENT_SECRET: ''

  # 어드민 이용 통계 (web만 읽는다. web.yaml이 Secret에서 읽으므로 속성 ID도 여기 둔다)
  GA4_PROPERTY_ID: ''
  GA4_SERVICE_ACCOUNT_KEY: ''

  # 외부 서비스
  OPENAI_API_KEY: ''
  SLACK_WEBHOOK_URL: ''

  # 앱 설정에 기본값이 없어 키가 꼭 있어야 한다. 운영 ES도 보안이 꺼져 있어 빈 값이다
  ELASTICSEARCH_USERNAME: ''
  ELASTICSEARCH_PASSWORD: ''
