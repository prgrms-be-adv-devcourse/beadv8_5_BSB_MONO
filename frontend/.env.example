# 복사해서 .env.local로 쓰세요. 설명은 src/shared/config/env.ts 참고.

# 서버가 API를 보낼 곳 (로컬 백엔드 API 게이트웨이. 게이트웨이가 경로를 보고 각 서비스로 넘긴다)
BACKEND_URL=http://localhost:8000

# on: MSW 가짜 응답 / off: BACKEND_URL로 프록시. 백엔드가 생기기 전까지는 on.
API_MOCKING=on

# 공유 카드(og:image)에 들어갈 사이트 주소. Vercel에서는 비워도 운영 주소를 씀. AWS 배포 때는 꼭 설정
# 운영 CD 빌드(app-cd.yml)는 이 파일이 아니라 저장소 Variables에서 읽는다
SITE_URL=

# next/image 최적화를 허용할 이미지 호스트 (쉼표 구분)
IMAGE_REMOTE_HOSTS=

# 설정하면 next/image가 이 CDN 주소로 직접 요청 (AWS에서 서버 CPU 아끼기용)
NEXT_PUBLIC_IMAGE_CDN_URL=

# 토스페이먼츠 결제창 클라이언트 키. 테스트 키(test_ck_로 시작)만 쓴다. 백엔드 TOSS_SECRET_KEY(test_sk_)와 같은 상점 키여야 한다
# API_MOCKING=on이면 결제창 없이 바로 충전 성공으로 넘어가므로 비워도 된다
# 운영 CD 빌드(app-cd.yml)는 이 파일이 아니라 저장소 Variables(Settings → Secrets and variables → Actions → Variables)에서 읽는다
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# Google 태그 관리자 컨테이너 ID(GTM-로 시작). 비우면 GTM을 넣지 않고 사용자 활동 이벤트도 보내지 않는다
# API_MOCKING=on이면 값이 있어도 넣지 않는다. 로컬 개발에서는 비워 둔다
# 운영 CD 빌드(app-cd.yml)는 이 파일이 아니라 저장소 Variables에서 읽는다
NEXT_PUBLIC_GTM_ID=

# Microsoft Clarity(화면 녹화 · 히트맵) 프로젝트 ID. Clarity 프로젝트 Settings → Setup에 있다. 비우면 넣지 않는다
# API_MOCKING=on이면 값이 있어도 넣지 않고, 어드민 화면은 녹화하지 않는다. 로컬 개발에서는 비워 둔다
# 운영 CD 빌드(app-cd.yml)는 이 파일이 아니라 저장소 Variables에서 읽는다
NEXT_PUBLIC_CLARITY_ID=

# 카카오 JavaScript 키(카카오 콘솔 앱 > 플랫폼 키, 32자리 16진수). 크루 초대 링크를 카카오톡으로 공유할 때 쓴다
# 비우면 「카카오톡으로 공유하기」 버튼을 숨긴다
# 카카오 콘솔 두 곳에 이 사이트 주소를 등록해야 한다. 「JavaScript SDK 도메인」이 없으면 공유 창이 오류를 보이고,
# 「제품 링크 관리 > 웹 도메인」이 없으면 받은 메시지의 링크·버튼이 동작하지 않는다
# 운영 CD 빌드(app-cd.yml)는 이 파일이 아니라 저장소 Variables에서 읽는다
NEXT_PUBLIC_KAKAO_JS_KEY=

# 포트원 가입 본인인증(KG이니시스 통합인증) 상점 아이디와 채널 키. 공개해도 되는 값이다
# 상점 아이디는 백엔드 PORTONE_STORE_ID와 같은 값이다. 비우면 API_MOCKING=off에서 본인인증 창이 열리지 않는다
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_IDENTITY_CHANNEL_KEY=

# 검색엔진 소유 확인 코드. 구글 Search Console · 네이버 서치어드바이저의 「HTML 태그」 방식에서 content 값만 넣는다
# 비우면 확인 태그를 넣지 않는다. 운영 CD 빌드(app-cd.yml)는 이 파일이 아니라 저장소 Variables에서 읽는다
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# 어드민 「이용 통계」가 GA4 Data API를 부를 때 쓴다. 서버 전용이라 NEXT_PUBLIC_을 붙이지 않는다(브라우저로 나가지 않는다)
# 서버가 실행될 때 읽으므로 다시 빌드하지 않아도 된다. 둘 중 하나라도 비우면 화면에 「GA4 연결 정보가 없어요」가 보인다
# API_MOCKING=on이면 값이 없어도 예시 숫자를 보여 준다. 키 값은 레포에 올리지 않는다
## GA4 속성 ID(숫자). GA4 관리 → 속성 설정에 있다. 측정 ID(G-로 시작)가 아니다
GA4_PROPERTY_ID=
## 서비스 계정 키 JSON을 base64로 바꾼 한 줄 (base64 -i key.json | tr -d '\n'). JSON 한 줄도 받는다
GA4_SERVICE_ACCOUNT_KEY=
