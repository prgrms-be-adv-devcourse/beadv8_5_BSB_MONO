# 복사해서 .env.local로 쓰세요. 설명은 src/shared/config/env.ts 참고.

# 서버가 API를 보낼 곳 (로컬 Spring Boot 백엔드)
BACKEND_URL=http://localhost:8080

# on: MSW 가짜 응답 / off: BACKEND_URL로 프록시. 백엔드가 생기기 전까지는 on.
API_MOCKING=on

# next/image 최적화를 허용할 이미지 호스트 (쉼표 구분)
IMAGE_REMOTE_HOSTS=

# 설정하면 next/image가 이 CDN 주소로 직접 요청 (AWS에서 서버 CPU 아끼기용)
NEXT_PUBLIC_IMAGE_CDN_URL=
