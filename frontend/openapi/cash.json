  "components": {
    "schemas": {
      "CashPayoutRequestDto": {
        "type": "object",
        "description": "정산 지급 요청",
        "properties": {
          "sellerId": {
            "type": "integer",
            "format": "int64",
            "description": "정산액을 받을 판매자 ID (판매자 신청서 ID, 회원 ID 아님)",
            "example": 10,
            "minimum": 0
          },
          "payoutStage": {
            "type": "string",
            "description": "정산 단계 (FIRST: 1차, FINAL: 최종)",
            "enum": [
              "FIRST",
              "FINAL"
            ],
            "example": "FINAL"
          },
          "settlementAmount": {
            "type": "integer",
            "format": "int64",
            "description": "판매자에게 지급할 정산 대금 (최종 정산은 회수 상계로 0원이 될 수 있음)",
            "example": 90000,
            "minimum": 0
          },
          "feeAmount": {
            "type": "integer",
            "format": "int64",
            "description": "시스템 지갑으로 보낼 수수료 (1차 정산은 0)",
            "example": 5500,
            "minimum": 0
          }
        },
        "required": [
          "feeAmount",
          "payoutStage",
          "sellerId",
          "settlementAmount"
        ]
      },
      "RsData": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        }
      },
      "CashPaymentRequestDto": {
        "type": "object",
        "description": "주문 결제 요청",
        "properties": {
          "memberId": {
            "type": "integer",
            "format": "int64",
            "description": "결제할 회원 ID (지갑 주인)",
            "example": 3,
            "minimum": 0
          },
          "amount": {
            "type": "integer",
            "format": "int64",
            "description": "결제 금액",
            "example": 10000,
            "minimum": 0
          }
        },
        "required": [
          "amount",
          "memberId"
        ]
      },
      "CashRefundRequestDto": {
        "type": "object",
        "description": "참가권 취소에 따른 예치금 환불 요청",
        "properties": {
          "memberId": {
            "type": "integer",
            "format": "int64",
            "description": "환불받을 회원 ID (지갑 주인)",
            "example": 3,
            "minimum": 0
          }
        },
        "required": [
          "memberId"
        ]
      },
      "CashCancelPaymentRequestDto": {
        "type": "object",
        "description": "결제 취소(환원) 요청",
        "properties": {
          "memberId": {
            "type": "integer",
            "format": "int64",
            "description": "결제를 취소할 회원 ID (지갑 주인)",
            "example": 3,
            "minimum": 0
          }
        },
        "required": [
          "memberId"
        ]
      },
      "CashWithdrawalRequestDto": {
        "type": "object",
        "description": "예치금 전액 환급 신청. 은행 정보는 계좌로 보낼 몫이 있을 때만 필요하다",
        "properties": {
          "bankCode": {
            "type": "string",
            "description": "은행 코드 (계좌로 보낼 몫이 있을 때만)",
            "example": "004",
            "maxLength": 10,
            "minLength": 0
          },
          "accountNumber": {
            "type": "string",
            "description": "계좌번호 (계좌로 보낼 몫이 있을 때만)",
            "example": "110123456789",
            "maxLength": 255,
            "minLength": 0
          },
          "accountHolder": {
            "type": "string",
            "description": "예금주명 (계좌로 보낼 몫이 있을 때만)",
            "example": "홍길동",
            "maxLength": 50,
            "minLength": 0
          }
        }
      },
      "CashChargeConfirmRequestDto": {
        "type": "object",
        "description": "충전 승인 확정 요청",
        "properties": {
          "paymentKey": {
            "type": "string",
            "description": "Toss 결제 키",
            "example": "5EnNZRJGvaBd3GirPNB6s",
            "maxLength": 200,
            "minLength": 0
          },
          "orderId": {
            "type": "string",
            "description": "충전 요청 고유 ID (멱등키)",
            "example": "charge-1697000000000",
            "maxLength": 64,
            "minLength": 0
          },
          "amount": {
            "type": "integer",
            "format": "int64",
            "description": "충전 요청 금액 (최소 10,000원)",
            "example": 10000,
            "minimum": 0
          }
        },
        "required": [
          "amount",
          "orderId",
          "paymentKey"
        ]
      }
    }
  }
}
