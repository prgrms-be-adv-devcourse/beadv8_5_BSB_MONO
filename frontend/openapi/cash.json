{
  "openapi": "3.1.0",
  "info": {
    "title": "Bukang Cash API",
    "description": "크루 중심 마라톤 대회 예매·커머스 플랫폼 캐시 API",
    "version": "v1"
  },
  "tags": [
    {
      "name": "CashInternal",
      "description": "주문 결제, 결제 취소(환원), 환불, 잔액 조회 API (서비스 간 내부 호출 전용)"
    },
    {
      "name": "Cash",
      "description": "예치금 지갑 잔액 조회 API"
    }
  ],
  "paths": {
    "/api/v1/cash/withdrawals": {
      "post": {
        "tags": [
          "Cash"
        ],
        "summary": "예치금 전액 환급 신청",
        "description": "회원이 남은 예치금 전액을 환급 신청한다. PG 결제취소 기한 안인 충전 건은 결제한 카드로 결제취소하고, 나머지(기한이 지난 몫, 충전이 아닌 정산 대금)는 계좌로 보낸다. 은행 정보는 계좌로 보낼 몫이 있을 때만 필요하다. 결제취소 결과를 모르는 몫은 처리 중으로 두고 재확인이 맞추며, 거절된 몫은 예치금에 되돌린다. Idempotency-Key 헤더로 같은 요청은 한 번만 처리하고, 같은 키로 다시 오면 지금 처리 상태를 돌려준다.",
        "operationId": "requestWithdrawal",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "로그인한 회원 ID (게이트웨이가 Access Token에서 꺼내 넣는다)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "중복 환급 방지 키. 같은 [환급 신청] 재시도에는 같은 값을 보낸다 (예: UUID)",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1
            },
            "example": "6f1c2a7e-3b9d-4f0a-9c55-0d2e8b7a1f43"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CashWithdrawalRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "환급 신청 완료. 금액은 카드 결제취소 요청·계좌 송금·처리 중·예치금에 되돌림으로 나뉜다. accountRequired가 true면 카드로 돌려줄 수 없는 몫이 계좌 정보가 없어 되돌아갔다",
            "content": {
              "application/json": {
                "examples": {
                  "카드와 계좌로 나눠 환급": {
                    "description": "카드와 계좌로 나눠 환급",
                    "value": {
                      "status": 200,
                      "message": "환급 신청이 완료되었습니다.",
                      "data": {
                        "withdrawnAmount": 130000,
                        "balance": 0,
                        "cardAmount": 30000,
                        "accountAmount": 100000,
                        "processingAmount": 0,
                        "revertedAmount": 0,
                        "accountRequired": false
                      }
                    }
                  },
                  "일부 처리 중·되돌림": {
                    "description": "일부 처리 중·되돌림",
                    "value": {
                      "status": 200,
                      "message": "환급 신청이 완료되었습니다.",
                      "data": {
                        "withdrawnAmount": 130000,
                        "balance": 10000,
                        "cardAmount": 30000,
                        "accountAmount": 70000,
                        "processingAmount": 20000,
                        "revertedAmount": 10000,
                        "accountRequired": false
                      }
                    }
                  },
                  "계좌 정보가 없어 되돌림": {
                    "description": "계좌 정보가 없어 되돌림",
                    "value": {
                      "status": 200,
                      "message": "환급 신청이 완료되었습니다.",
                      "data": {
                        "withdrawnAmount": 30000,
                        "balance": 30000,
                        "cardAmount": 0,
                        "accountAmount": 0,
                        "processingAmount": 0,
                        "revertedAmount": 30000,
                        "accountRequired": true
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "환급할 잔액 없음, 계좌로 보낼 몫이 있는데 계좌 정보 없음, 입력값 검증 실패, 요청 본문 형식 오류, 회원 ID 형식 오류·0 이하 또는 Idempotency-Key 헤더 없음·길이 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "환급할 잔액 없음": {
                    "description": "환급할 잔액 없음",
                    "value": {
                      "status": 400,
                      "message": "환급할 잔액이 없습니다.",
                      "data": null
                    }
                  },
                  "계좌 정보 필요": {
                    "description": "계좌 정보 필요",
                    "value": {
                      "status": 400,
                      "code": "WITHDRAWAL_ACCOUNT_REQUIRED",
                      "message": "계좌로 돌려드릴 금액이 있어 계좌 정보가 필요합니다.",
                      "data": null
                    }
                  },
                  "입력값 검증 실패": {
                    "description": "입력값 검증 실패",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "은행 코드는 10자 이하여야 합니다.",
                      "data": null
                    }
                  },
                  "요청 본문 형식 오류": {
                    "description": "요청 본문 형식 오류",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "요청 본문 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  },
                  "회원 ID 형식 오류": {
                    "description": "회원 ID 형식 오류",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "요청 값의 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  },
                  "회원 ID가 0 이하": {
                    "description": "회원 ID가 0 이하",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "회원 ID가 올바르지 않습니다.",
                      "data": null
                    }
                  },
                  "Idempotency-Key 헤더 없음": {
                    "description": "Idempotency-Key 헤더 없음",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "필수 요청 헤더(Idempotency-Key)가 없습니다.",
                      "data": null
                    }
                  },
                  "Idempotency-Key 길이 오류": {
                    "description": "Idempotency-Key 길이 오류",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "Idempotency-Key는 1~64자로 보내주세요.",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "회원 ID 헤더 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 401,
                  "code": "LOGIN_REQUIRED",
                  "message": "로그인이 필요합니다.",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "지갑 없음 (회원 가입 이벤트가 아직 처리되지 않았거나 없는 회원)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 404,
                  "message": "존재하지 않는 지갑입니다.",
                  "data": null
                }
              }
            }
          },
          "409": {
            "description": "처리 중인 환급 있음 또는 다른 회원이 환급 신청에 쓴 Idempotency-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "처리 중인 환급 있음": {
                    "description": "처리 중인 환급 있음",
                    "value": {
                      "status": 409,
                      "code": "WITHDRAWAL_IN_PROGRESS",
                      "message": "처리 중인 환급이 있어 끝난 뒤에 다시 신청할 수 있습니다.",
                      "data": null
                    }
                  },
                  "다른 회원의 Idempotency-Key": {
                    "description": "다른 회원의 Idempotency-Key",
                    "value": {
                      "status": 409,
                      "message": "이 Idempotency-Key로 환급한 회원과 요청한 회원이 다릅니다.",
                      "data": null
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cash/charges/confirm": {
      "post": {
        "tags": [
          "Cash"
        ],
        "summary": "충전 승인 확정",
        "description": "프론트가 Toss 결제위젯 콜백으로 받은 paymentKey·orderId·amount로 PG 승인을 확정하고, 성공하면 예치금 지갑에 반영한다. orderId를 멱등키로 써서 같은 요청이 여러 번 와도 한 번만 처리한다.",
        "operationId": "confirmWalletCharge",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "로그인한 회원 ID (게이트웨이가 Access Token에서 꺼내 넣는다)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CashChargeConfirmRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "충전 확정 처리됨 (성공 또는 PG 승인 거절)",
            "content": {
              "application/json": {
                "examples": {
                  "충전 성공": {
                    "description": "충전 성공",
                    "value": {
                      "status": 200,
                      "message": "충전했습니다.",
                      "data": {
                        "outcome": "COMPLETED",
                        "balance": 60000
                      }
                    }
                  },
                  "PG 승인 거절": {
                    "description": "PG 승인 거절",
                    "value": {
                      "status": 200,
                      "message": "충전에 실패했습니다.",
                      "data": {
                        "outcome": "FAILED",
                        "balance": 50000
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "최소 충전 금액 미만, 입력값 검증 실패, 요청 본문 형식 오류, 회원 ID 형식 오류 또는 0 이하",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "최소 충전 금액 미만": {
                    "description": "최소 충전 금액 미만",
                    "value": {
                      "status": 400,
                      "message": "최소 충전 금액은 10,000원입니다.",
                      "data": null
                    }
                  },
                  "입력값 검증 실패": {
                    "description": "입력값 검증 실패",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "paymentKey를 작성해주세요.",
                      "data": null
                    }
                  },
                  "요청 본문 형식 오류": {
                    "description": "요청 본문 형식 오류",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "요청 본문 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  },
                  "회원 ID 형식 오류": {
                    "description": "회원 ID 형식 오류",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "요청 값의 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  },
                  "회원 ID가 0 이하": {
                    "description": "회원 ID가 0 이하",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "회원 ID가 올바르지 않습니다.",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "회원 ID 헤더 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 401,
                  "code": "LOGIN_REQUIRED",
                  "message": "로그인이 필요합니다.",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "지갑 없음 (회원 가입 이벤트가 아직 처리되지 않았거나 없는 회원)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 404,
                  "message": "존재하지 않는 지갑입니다.",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cash/wallets/refundable-charges": {
      "get": {
        "tags": [
          "Cash"
        ],
        "summary": "환급 화면용 충전 내역 조회",
        "description": "요청자 본인의 완료된 충전을 최근 순으로 조회한다. 남은 예치금을 최근 충전부터 채워 충전 건별 남은 금액을 계산하고, 건마다 카드 취소 마지막 날(승인일 + 1년 − 1일, 이날 24:00까지 한국 시간)과 기한 지남 여부를 붙인다. earliestLastCancelableDate는 남은 금액이 있고 기한이 지나지 않은 충전 중 가장 빠른 마지막 날이며, 없으면 null이다.",
        "operationId": "getRefundableCharges",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "로그인한 회원 ID (게이트웨이가 Access Token에서 꺼내 넣는다)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공 (충전이 없으면 빈 목록)",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "환급 화면용 충전 내역을 조회했습니다.",
                  "data": {
                    "balance": 25000,
                    "earliestLastCancelableDate": "2027-10-12",
                    "charges": [
                      {
                        "chargeId": 3,
                        "chargedAt": "2026-10-13T09:00:00",
                        "amount": 20000,
                        "remainingAmount": 20000,
                        "lastCancelableDate": "2027-10-12",
                        "expired": false
                      },
                      {
                        "chargeId": 2,
                        "chargedAt": "2026-10-10T09:00:00",
                        "amount": 10000,
                        "remainingAmount": 5000,
                        "lastCancelableDate": "2027-10-09",
                        "expired": true
                      },
                      {
                        "chargeId": 1,
                        "chargedAt": "2026-01-13T09:00:00",
                        "amount": 15000,
                        "remainingAmount": 0,
                        "lastCancelableDate": "2027-01-12",
                        "expired": true
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "회원 ID 형식 오류 또는 0 이하",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "회원 ID 형식 오류": {
                    "description": "회원 ID 형식 오류",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "요청 값의 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  },
                  "회원 ID가 0 이하": {
                    "description": "회원 ID가 0 이하",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "회원 ID가 올바르지 않습니다.",
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "회원 ID 헤더 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 401,
                  "code": "LOGIN_REQUIRED",
                  "message": "로그인이 필요합니다.",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "지갑 없음 (회원 가입 이벤트가 아직 처리되지 않았거나 없는 회원)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 404,
                  "message": "존재하지 않는 지갑입니다.",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cash/wallets/ledgers": {
      "get": {
        "tags": [
          "Cash"
        ],
        "summary": "예치금 내역 조회",
        "description": "요청자 본인 지갑의 내역을 최신순으로 조회한다. category로 탭(CHARGE/PAYMENT/REFUND/WITHDRAWAL/PAYOUT)을 필터링할 수 있고, 생략하면 전체를 돌려준다. 충전 줄의 charge에는 환급 화면용 충전 내역 조회와 같은 남은 금액·카드 취소 마지막 날이 있고, 다른 줄은 null이다.",
        "operationId": "getLedgers",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "로그인한 회원 ID (게이트웨이가 Access Token에서 꺼내 넣는다)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          },
          {
            "name": "category",
            "in": "query",
            "description": "탭 필터. 생략하면 전체",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CHARGE",
                "PAYMENT",
                "REFUND",
                "WITHDRAWAL",
                "PAYOUT"
              ]
            },
            "example": "CHARGE"
          },
          {
            "name": "page",
            "in": "query",
            "description": "페이지 번호 (0부터)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            },
            "example": 0
          },
          {
            "name": "size",
            "in": "query",
            "description": "페이지 크기 (1~100)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            },
            "example": 20
          }
        ],
        "responses": {
          "200": {
