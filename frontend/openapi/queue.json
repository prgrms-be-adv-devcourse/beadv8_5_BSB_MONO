{
  "openapi": "3.1.0",
  "info": {
    "title": "Bukang Queue API",
    "description": "크루 중심 마라톤 대회 예매·커머스 플랫폼 대기열 API",
    "version": "v1"
  },
  "tags": [
    {
      "name": "Queue",
      "description": "대기열 등록, 순번 조회 API"
    },
    {
      "name": "QueueDlt",
      "description": "Kafka 처리 실패 메시지 목록, 다시 보내기, 처리 완료 API (운영자 내부 호출 전용)"
    },
    {
      "name": "PartyQueue",
      "description": "파티 대기열 등록, 순번 조회 API"
    },
    {
      "name": "PartyQueueAdmission",
      "description": "주문 서비스용 파티 대기열 입장 확인 API (서비스 간 내부 호출 전용)"
    },
    {
      "name": "QueueAdmission",
      "description": "주문 서비스용 대기열 입장 확인 API (서비스 간 내부 호출 전용)"
    }
  ],
  "paths": {
    "/internal/v1/queue/kafka-failures/{id}/resend": {
      "post": {
        "tags": [
          "QueueDlt"
        ],
        "summary": "처리 실패 메시지 다시 보내기",
        "description": "처리 실패 상태의 메시지를 message-id 헤더째 queue의 첫 재시도 토픽으로 다시 보내고 다시 보냄으로 바꾼다. queue만 다시 받고(같은 토픽을 받는 다른 서비스는 받지 않음), 처리되면 처리 완료로, 또 실패하면 처리 실패로 돌아가 Slack으로 다시 알린다. Kafka로 보내지 못하면 처리 실패로 되돌리고 503으로 응답한다.",
        "operationId": "resend",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "DLT 실패 행 ID (Slack 알림의 행 ID)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 15
          }
        ],
        "responses": {
          "200": {
            "description": "다시 보냄",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "메시지를 다시 보냈습니다.",
                  "data": {
                    "id": 15,
                    "status": "RESENT",
                    "originalTopic": "queuing.race.changed",
                    "dltTopic": "queuing.race.changed.queue.dlt",
                    "dltPartition": 0,
                    "dltOffset": 7,
                    "messageKey": "1",
                    "messageId": "product-outbox-7c9e6679-7425-40de-944b-e07fc1f90a42",
                    "payload": "{\"raceId\":1,\"saleStatus\":\"ON_SALE\"}",
                    "exceptionClass": "org.springframework.dao.DataIntegrityViolationException",
                    "exceptionMessage": "could not execute statement",
                    "createDate": "2026-11-04T10:15:30",
                    "resentDate": "2026-11-04T11:02:10",
                    "completedDate": null,
                    "completeMemo": null
                  }
                }
              }
            }
          },
          "400": {
            "description": "ID 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 400,
                  "message": "요청 값의 형식이 올바르지 않습니다.",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "없는 행",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 404,
                  "code": "KAFKA_DLT_NOT_FOUND",
                  "message": "[queue] DLT 메시지 15번이 없습니다.",
                  "data": null
                }
              }
            }
          },
          "409": {
            "description": "처리 실패 상태가 아님 (이미 다시 보냈거나 처리 완료)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 409,
                  "code": "KAFKA_DLT_INVALID_STATUS",
                  "message": "[queue] DLT 메시지 15번은 다시 보냄 상태라 다시 보낼 수 없습니다.",
                  "data": null
                }
              }
            }
          },
          "503": {
            "description": "Kafka로 보내지 못함 (처리 실패로 되돌림)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "example": {
                  "status": 503,
                  "code": "KAFKA_DLT_RESEND_FAILED",
                  "message": "[queue] DLT 메시지 15번을 Kafka로 다시 보내지 못했습니다. 잠시 뒤 다시 시도하세요.",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/queue/kafka-failures/{id}/complete": {
