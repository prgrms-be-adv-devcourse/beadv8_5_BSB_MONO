    "/api/v1/queue": {
      "post": {
        "tags": [
          "Queue"
        ],
        "summary": "대기열 등록",
        "description": "대회·종목의 대기열에 회원을 줄 세우고 순번을 돌려준다. 판매 중이고 개인 예매 오픈부터 접수 마감 전까지만 들어올 수 있다. 이미 줄에 있는 회원이 다시 등록하면(다른 기기 등) 처음 순번을 그대로 돌려준다. 이미 입장(active)한 회원은 다시 줄을 설 수 없다. 대기열(Redis)에 연결하지 못하면 대기열 없이 통과시키지 않고 막는다.",
        "operationId": "register",
        "parameters": [
          {
            "name": "X-Member-Id",
            "in": "header",
            "description": "로그인한 회원 ID (게이트웨이가 Access Token에서 꺼내 넣는다)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueueRegisterRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "등록 성공 (이미 줄에 있으면 처음 순번)",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "대기열에 등록했습니다.",
                  "data": {
                    "myRank": 3,
                    "ahead": 2,
                    "total": 10,
                    "canEnter": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "입력값 검증 실패, 요청 본문 형식 오류 또는 회원 ID 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsData"
                },
                "examples": {
                  "입력값 검증 실패": {
                    "description": "입력값 검증 실패",
                    "value": {
                      "status": 400,
                      "message": "대회 ID를 작성해주세요.",
                      "data": null
                    }
                  },
                  "요청 본문 형식 오류": {
                    "description": "요청 본문 형식 오류",
                    "value": {
                      "status": 400,
                      "message": "요청 본문 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  },
                  "회원 ID 형식 오류": {
                    "description": "회원 ID 형식 오류",
                    "value": {
                      "status": 400,
                      "message": "요청 값의 형식이 올바르지 않습니다.",
                      "data": null
                    }
                  },
                  "회원 ID가 0 이하": {
                    "description": "회원 ID가 0 이하",
                    "value": {
                      "status": 400,
                      "code": "INVALID_REQUEST",
                      "message": "회원 ID가 올바르지 않습니다.",
                      "data": null
