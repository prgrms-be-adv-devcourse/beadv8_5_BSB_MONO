          "type": "integer",
          "format": "int64"
        },
        "startDate": {
          "type": "string",
          "format": "date",
          "description": "상계 실패일"
        },
        "dueDate": {
          "type": "string",
          "format": "date",
          "description": "판매자 입금 기한 (상계 실패일 + 30일)"
        },
        "status": {
