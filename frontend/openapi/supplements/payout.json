{
  "responses": {
    "summary": {
      "200": {
        "wrapper": "RsDataPayoutSummaryDto",
        "data": {
          "$ref": "#/components/schemas/PayoutSummaryDto"
        }
      }
    },
    "payouts": {
      "200": {
        "wrapper": "RsDataListPayoutDto",
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/PayoutDto"
          }
        }
      }
    },
    "items": {
      "200": {
        "wrapper": "RsDataPayoutItemPageDto",
        "data": {
          "$ref": "#/components/schemas/PayoutItemPageDto"
        }
      }
    },
    "holds": {
      "200": {
        "wrapper": "RsDataListSellerPayoutHoldDto",
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/SellerPayoutHoldDto"
          }
        }
      }
    },
    "hold": {
      "201": {
        "wrapper": "RsDataPayoutHoldDto",
        "data": {
          "$ref": "#/components/schemas/PayoutHoldDto"
        }
      }
    },
    "release": {
      "200": {
        "wrapper": "RsDataPayoutHoldDto",
        "data": {
          "$ref": "#/components/schemas/PayoutHoldDto"
        }
      }
    },
    "createFailures": {
      "200": {
        "wrapper": "RsDataPayoutCreateFailuresDto",
        "data": {
          "$ref": "#/components/schemas/PayoutCreateFailuresDto"
        }
      }
    }
  },
  "schemas": {
    "PayoutSummaryDto": {
      "type": "object",
      "properties": {
        "nextPayDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "다음 정산일. 지급 예정 정산 내역이 없으면 null"
        },
        "scheduledPayoutAmount": {
          "type": "integer",
          "format": "int64"
        },
        "heldCount": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "nextPayDate",
        "scheduledPayoutAmount",
        "heldCount"
      ]
    },
    "PayoutDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "payoutCode": {
          "type": "string"
        },
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "raceName": {
          "type": "string"
        },
        "payoutStage": {
          "$ref": "#/components/schemas/PayoutStage"
        },
        "payoutMonth": {
          "type": "string"
        },
        "salesAmount": {
          "type": "integer",
          "format": "int64"
        },
        "refundAmount": {
          "type": "integer",
          "format": "int64"
        },
        "feeAmount": {
          "type": "integer",
          "format": "int64"
        },
        "advanceDeductionAmount": {
          "type": "integer",
          "format": "int64",
          "description": "1차 정산금 차감 (최종에서 뺀 1차 지급액 − 회수액, 1차는 0)"
        },
        "payoutAmount": {
          "type": "integer",
          "format": "int64"
        },
        "status": {
          "$ref": "#/components/schemas/PayoutStatus"
        },
        "settledAt": {
          "type": "string",
          "format": "date-time"
        },
        "scheduledPayDate": {
          "type": "string",
          "format": "date"
        },
        "paidAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        }
      },
      "required": [
        "id",
        "payoutCode",
        "raceId",
        "raceName",
        "payoutStage",
        "payoutMonth",
        "salesAmount",
        "refundAmount",
        "feeAmount",
        "advanceDeductionAmount",
        "payoutAmount",
        "status",
        "settledAt",
        "scheduledPayDate"
      ]
    },
    "PayoutItemDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "orderItemId": {
          "type": "integer",
          "format": "int32",
          "nullable": true
        },
        "recordType": {
          "$ref": "#/components/schemas/PayoutRecordType"
        },
        "amount": {
          "type": "integer",
          "format": "int64"
        },
        "feeRate": {
          "type": "number"
        },
        "feeAmount": {
          "type": "integer",
          "format": "int64"
        },
        "targetDate": {
          "type": "string",
          "format": "date"
        },
        "payoutId": {
          "type": "integer",
          "format": "int32"
        },
        "payoutCode": {
          "type": "string"
        },
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "raceName": {
          "type": "string"
        },
        "payoutStatus": {
          "$ref": "#/components/schemas/PayoutStatus"
        },
        "scheduledPayDate": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "id",
        "recordType",
        "amount",
        "feeRate",
        "feeAmount",
        "targetDate",
        "payoutId",
        "payoutCode",
        "raceId",
        "raceName",
        "payoutStatus",
        "scheduledPayDate"
      ]
    },
    "PayoutItemPageDto": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/PayoutItemDto"
          }
        },
        "page": {
          "type": "integer",
          "format": "int32"
        },
        "size": {
          "type": "integer",
          "format": "int32"
        },
        "totalElements": {
          "type": "integer",
          "format": "int64"
        },
        "totalPages": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "content",
        "page",
        "size",
        "totalElements",
        "totalPages"
      ]
    },
    "SellerPayoutHoldDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "holdCode": {
          "type": "string"
        },
        "payoutId": {
          "type": "integer",
          "format": "int32"
        },
        "payoutCode": {
          "type": "string"
        },
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "raceName": {
          "type": "string"
        },
        "payoutAmount": {
          "type": "integer",
          "format": "int64"
        },
        "reasonType": {
          "$ref": "#/components/schemas/PayoutHoldReason"
        },
        "reason": {
          "type": "string",
          "nullable": true
        },
        "status": {
          "$ref": "#/components/schemas/PayoutHoldStatus"
        },
        "heldAt": {
          "type": "string",
          "format": "date-time"
        },
        "releasedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        }
      },
      "required": [
        "id",
        "holdCode",
        "payoutId",
        "payoutCode",
        "raceId",
        "raceName",
        "payoutAmount",
        "reasonType",
        "status",
        "heldAt"
      ]
    },
    "PayoutHoldDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "holdCode": {
          "type": "string"
        },
        "payoutId": {
          "type": "integer",
          "format": "int32"
        },
        "reasonType": {
          "$ref": "#/components/schemas/PayoutHoldReason"
        },
        "reason": {
          "type": "string",
          "nullable": true
        },
        "status": {
          "$ref": "#/components/schemas/PayoutHoldStatus"
        },
        "heldBy": {
          "type": "integer",
          "format": "int32"
        },
        "heldAt": {
          "type": "string",
          "format": "date-time"
        },
        "releasedBy": {
          "type": "integer",
          "format": "int32",
          "nullable": true
        },
        "releasedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        }
      },
      "required": [
        "id",
        "holdCode",
        "payoutId",
        "reasonType",
        "status",
        "heldBy",
        "heldAt"
      ]
    },
    "PayoutStatus": {
      "type": "string",
      "enum": [
        "지급_예정",
        "지급보류",
        "지급_중",
        "지급_완료",
        "취소",
        "지급_불일치"
      ],
      "description": "정산 상태 (지급_예정: 지급 예정, 지급보류: 지급보류, 지급_중: 지급 중, 지급_완료: 지급 완료, 취소: 취소, 지급_불일치: 캐시가 이미 다른 금액으로 지급했다고 답해 확인 중)"
    },
    "PayoutHoldStatus": {
      "type": "string",
      "enum": [
        "지급보류",
        "해제"
      ],
      "description": "지급보류 상태 (지급보류: 지급보류, 해제: 해제)"
    },
    "PayoutHoldReason": {
      "type": "string",
      "enum": [
        "정산_계좌_미등록",
        "대회_취소_처리",
        "대사_불일치"
      ],
      "description": "보류 사유 (정산_계좌_미등록: 정산 계좌 미등록, 대회_취소_처리: 대회 취소 처리, 대사_불일치: 대사 불일치)"
    },
    "PayoutRecordType": {
      "type": "string",
      "enum": [
        "선금",
        "판매",
        "수수료",
        "선지급_차감",
        "회수_요청",
        "갚을_돈_추가",
        "회수_상계",
        "회수_입금",
        "선금_취소",
        "판매_취소",
        "수수료_취소",
        "선지급_차감_취소",
        "회수_상계_취소"
      ],
      "description": "원장 줄 종류 (선금: 선금, 판매: 판매, 수수료: 수수료, 선지급_차감: 선지급 차감, 회수_요청: 회수 요청, 갚을_돈_추가: 갚을 돈 추가, 회수_상계: 회수 상계, 회수_입금: 회수 입금, 선금_취소: 선금 취소, 판매_취소: 판매 취소, 수수료_취소: 수수료 취소, 선지급_차감_취소: 선지급 차감 취소, 회수_상계_취소: 회수 상계 취소)"
    },
    "PayoutStage": {
      "type": "string",
      "enum": [
        "일차_정산",
        "최종_정산"
      ],
      "description": "정산 단계 (일차_정산: 1차 정산, 최종_정산: 최종 정산)"
    },
    "PayoutCreateFailureType": {
      "type": "string",
      "enum": [
        "주문_정산_대회일_불일치",
        "정산_계좌_조회_실패",
        "정산_저장_실패",
        "정산_조회_실패",
        "알_수_없는_실패",
        "대회_조회_실패",
        "주문_조회_실패",
        "취소_중이라_미룸",
        "대사_불일치"
      ],
      "description": "정산 생성 실패 종류"
    },
    "PayoutCreateFailureAction": {
      "type": "string",
      "enum": [
        "지급보류",
        "자동_보정",
        "기록만"
      ],
      "description": "배치가 기록할 때 한 조치 (지급보류, 자동_보정: 빠진 참가권 채움, 기록만)"
    },
    "PayoutCreateFailureDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "runDate": {
          "type": "string",
          "format": "date"
        },
        "payoutStage": {
          "$ref": "#/components/schemas/PayoutStage"
        },
        "sellerId": {
          "type": "integer",
          "format": "int32",
          "nullable": true,
          "description": "대회 · 주문 조회 실패는 null"
        },
        "raceId": {
          "type": "integer",
          "format": "int32",
          "nullable": true,
          "description": "대회 조회 실패는 null"
        },
        "raceCourseId": {
          "type": "integer",
          "format": "int32",
          "nullable": true,
          "description": "대사 불일치에서 어긋난 코스가 하나일 때만"
        },
        "payoutTargetDate": {
          "type": "string",
          "format": "date",
          "nullable": true
        },
        "failureType": {
          "$ref": "#/components/schemas/PayoutCreateFailureType"
        },
        "actionTaken": {
          "allOf": [
            {
              "$ref": "#/components/schemas/PayoutCreateFailureAction"
            }
          ],
          "nullable": true,
          "description": "칸을 더하기 전의 대사 불일치 기록은 null"
        },
        "note": {
          "type": "string",
          "nullable": true
        },
        "soldCount": {
          "type": "integer",
          "format": "int32",
          "nullable": true,
          "description": "최종 정산 대사의 판매 장수. 1차와 다른 실패는 null"
        },
        "settledCount": {
          "type": "integer",
          "format": "int32",
          "nullable": true,
          "description": "최종 정산 대사의 정산 판매 줄 장수. 1차와 다른 실패는 null"
        },
        "holdCode": {
          "type": "string",
          "nullable": true,
          "description": "이 어긋남으로 걸린 지급보류 ID (HD-, 여럿이면 쉼표)"
        }
      },
      "required": [
        "id",
        "recordedAt",
        "runDate",
        "payoutStage",
        "sellerId",
        "raceId",
        "raceCourseId",
        "payoutTargetDate",
        "failureType",
        "actionTaken",
        "note",
        "soldCount",
        "settledCount",
        "holdCode"
      ]
    },
    "PayoutCreateFailurePageDto": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/PayoutCreateFailureDto"
          }
        },
        "page": {
          "type": "integer",
          "format": "int32"
        },
        "size": {
          "type": "integer",
          "format": "int32"
        },
        "totalElements": {
          "type": "integer",
          "format": "int64"
        },
        "totalPages": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "content",
        "page",
        "size",
        "totalElements",
        "totalPages"
      ]
    },
    "PayoutCreateFailuresDto": {
      "type": "object",
      "properties": {
        "mismatchCount": {
          "type": "integer",
          "format": "int64",
          "description": "대사 불일치 건수"
        },
        "autoFilledCount": {
          "type": "integer",
          "format": "int64",
          "description": "빠진 참가권을 채운 대사 불일치 건수 (장수 아님)"
        },
        "orderLookupFailureCount": {
          "type": "integer",
          "format": "int64",
          "description": "주문 조회 실패 건수"
        },
        "records": {
          "$ref": "#/components/schemas/PayoutCreateFailurePageDto"
        }
      },
      "required": [
        "mismatchCount",
        "autoFilledCount",
        "orderLookupFailureCount",
        "records"
      ]
    }
  }
}
