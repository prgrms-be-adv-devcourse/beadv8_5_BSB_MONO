        },
        "payoutAmount": {
          "type": "integer",
          "format": "int64"
        },
        "status": {
          "$ref": "#/components/schemas/PayoutStatus"
        },
        "settledAt": {
          "type": "string",
          "format": "date-time"
        },
        "scheduledPayDate": {
          "type": "string",
          "format": "date"
        },
        "paidAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        }
      },
      "required": [
        "id",
        "payoutCode",
        "raceId",
        "raceName",
        "payoutStage",
        "payoutMonth",
        "salesAmount",
        "refundAmount",
        "feeAmount",
        "advanceDeductionAmount",
        "payoutAmount",
        "status",
        "settledAt",
        "scheduledPayDate"
      ]
    },
    "PayoutItemDto": {
      "type": "object",
