    "PayoutStatus": {
      "type": "string",
      "enum": [
        "지급_예정",
        "지급보류",
        "지급_중",
        "지급_완료",
        "취소",
        "지급_불일치",
        "지급_확인_필요"
      ],
      "description": "정산 상태 (지급_예정: 지급 예정, 지급보류: 지급보류, 지급_중: 지급 중, 지급_완료: 지급 완료, 취소: 취소, 지급_불일치: 캐시가 이미 다른 금액으로 지급했다고 답해 확인 중, 지급_확인_필요: 지급 결과를 3번 몰라 사람이 확인 중)"
    },
    "PayoutHoldStatus": {
      "type": "string",
      "enum": [
        "지급보류",
        "해제"
      ],
      "description": "지급보류 상태 (지급보류: 지급보류, 해제: 해제)"
    },
    "PayoutHoldReason": {
      "type": "string",
      "enum": [
        "정산_계좌_미등록",
        "대회_취소_처리",
        "대사_불일치"
      ],
      "description": "보류 사유 (정산_계좌_미등록: 정산 계좌 미등록, 대회_취소_처리: 대회 취소 처리, 대사_불일치: 대사 불일치)"
    },
    "PayoutRecordType": {
      "type": "string",
      "enum": [
        "선금",
        "판매",
        "수수료",
        "선지급_차감",
        "회수_요청",
        "갚을_돈_추가",
        "회수_상계",
        "회수_입금",
        "선금_취소",
        "판매_취소",
        "수수료_취소",
        "선지급_차감_취소",
        "회수_상계_취소"
