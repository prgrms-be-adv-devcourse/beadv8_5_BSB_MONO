{
  "responses": {
    "summary": {
      "200": {
        "wrapper": "RsDataPayoutSummaryDto",
        "data": {
          "$ref": "#/components/schemas/PayoutSummaryDto"
        }
      }
    },
    "payouts": {
      "200": {
        "wrapper": "RsDataListPayoutDto",
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/PayoutDto"
          }
        }
      }
    },
    "items": {
      "200": {
        "wrapper": "RsDataPayoutItemPageDto",
        "data": {
          "$ref": "#/components/schemas/PayoutItemPageDto"
        }
      }
    },
    "holds": {
      "200": {
        "wrapper": "RsDataListSellerPayoutHoldDto",
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/SellerPayoutHoldDto"
          }
        }
      }
    },
    "hold": {
      "201": {
        "wrapper": "RsDataPayoutHoldDto",
        "data": {
          "$ref": "#/components/schemas/PayoutHoldDto"
        }
      }
    },
    "release": {
      "200": {
        "wrapper": "RsDataPayoutHoldDto",
        "data": {
          "$ref": "#/components/schemas/PayoutHoldDto"
        }
      }
    },
    "confirm": {
      "200": {
        "wrapper": "RsDataPayoutClaimDto",
        "data": {
          "$ref": "#/components/schemas/PayoutClaimDto"
        }
      }
    },
    "adminClaims": {
      "200": {
        "wrapper": "RsDataPayoutAdminClaimsDto",
        "data": {
          "$ref": "#/components/schemas/PayoutAdminClaimsDto"
        }
      }
    },
    "createFailures": {
      "200": {
        "wrapper": "RsDataPayoutCreateFailuresDto",
        "data": {
          "$ref": "#/components/schemas/PayoutCreateFailuresDto"
        }
      }
    },
    "payouts_1": {
      "200": {
        "wrapper": "RsDataPayoutAdminPayoutsDto",
        "data": {
          "$ref": "#/components/schemas/PayoutAdminPayoutsDto"
        }
      }
    },
    "findPayout": {
      "200": {
        "wrapper": "RsDataPayoutDto",
        "data": {
          "$ref": "#/components/schemas/PayoutDto"
        }
      }
    },
    "claims": {
      "200": {
        "wrapper": "RsDataListSellerRecoveryDto",
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/SellerRecoveryDto"
          }
        }
      }
    },
    "taxInvoices": {
      "200": {
        "wrapper": "RsDataListPayoutTaxInvoiceDto",
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/PayoutTaxInvoiceDto"
          }
        }
      }
    }
  },
  "schemas": {
    "PayoutSummaryDto": {
      "type": "object",
      "properties": {
        "nextPayDate": {
          "type": [
            "string",
            "null"
