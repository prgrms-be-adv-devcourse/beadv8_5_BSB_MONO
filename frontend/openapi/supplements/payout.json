{
  "responses": {
    "summary": {
      "200": {
        "wrapper": "RsDataPayoutSummaryDto",
        "data": {
          "$ref": "#/components/schemas/PayoutSummaryDto"
        }
      }
    },
    "payouts": {
      "200": {
        "wrapper": "RsDataListPayoutDto",
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/PayoutDto"
          }
        }
      }
    },
    "items": {
      "200": {
        "wrapper": "RsDataPayoutItemPageDto",
        "data": {
          "$ref": "#/components/schemas/PayoutItemPageDto"
        }
      }
    },
    "holds": {
      "200": {
        "wrapper": "RsDataListSellerPayoutHoldDto",
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/SellerPayoutHoldDto"
          }
        }
      }
    },
    "hold": {
      "201": {
        "wrapper": "RsDataPayoutHoldDto",
        "data": {
          "$ref": "#/components/schemas/PayoutHoldDto"
        }
      }
    },
    "release": {
      "200": {
        "wrapper": "RsDataPayoutHoldDto",
        "data": {
          "$ref": "#/components/schemas/PayoutHoldDto"
        }
      }
    }
  },
  "schemas": {
    "PayoutSummaryDto": {
      "type": "object",
      "properties": {
        "nextPayDate": {
          "type": ["string", "null"],
          "format": "date",
          "description": "다음 정산일. 지급 예정 정산 내역이 없으면 null"
        },
        "scheduledPayoutAmount": {
          "type": "integer",
          "format": "int64"
        },
        "heldCount": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "nextPayDate",
        "scheduledPayoutAmount",
        "heldCount"
      ]
    },
    "PayoutDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "payoutCode": {
          "type": "string"
        },
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "raceName": {
          "type": "string"
        },
        "payoutStage": {
          "$ref": "#/components/schemas/PayoutStage"
        },
        "payoutMonth": {
          "type": "string"
        },
        "salesAmount": {
          "type": "integer",
          "format": "int64"
        },
        "refundAmount": {
          "type": "integer",
          "format": "int64"
        },
        "feeAmount": {
          "type": "integer",
          "format": "int64"
        },
        "advanceDeductionAmount": {
          "type": "integer",
          "format": "int64",
          "description": "1차 정산금 차감 (최종에서 뺀 1차 지급액 − 회수액, 1차는 0)"
        },
        "payoutAmount": {
          "type": "integer",
          "format": "int64"
        },
        "status": {
          "$ref": "#/components/schemas/PayoutStatus"
        },
        "settledAt": {
          "type": "string",
          "format": "date-time"
        },
        "scheduledPayDate": {
          "type": "string",
          "format": "date"
        },
        "paidAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        }
      },
      "required": [
        "id",
        "payoutCode",
        "raceId",
        "raceName",
        "payoutStage",
        "payoutMonth",
        "salesAmount",
        "refundAmount",
        "feeAmount",
        "advanceDeductionAmount",
        "payoutAmount",
        "status",
        "settledAt",
        "scheduledPayDate"
      ]
    },
    "PayoutItemDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "orderItemId": {
          "type": "integer",
          "format": "int32",
          "nullable": true
        },
        "recordType": {
          "$ref": "#/components/schemas/PayoutRecordType"
        },
        "amount": {
          "type": "integer",
          "format": "int64"
        },
        "feeRate": {
          "type": "number"
        },
        "feeAmount": {
          "type": "integer",
          "format": "int64"
        },
        "targetDate": {
          "type": "string",
          "format": "date"
        },
        "payoutId": {
          "type": "integer",
          "format": "int32"
        },
        "payoutCode": {
          "type": "string"
        },
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "raceName": {
          "type": "string"
        },
        "payoutStatus": {
          "$ref": "#/components/schemas/PayoutStatus"
        },
        "scheduledPayDate": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "id",
        "recordType",
        "amount",
        "feeRate",
        "feeAmount",
        "targetDate",
        "payoutId",
        "payoutCode",
        "raceId",
        "raceName",
        "payoutStatus",
        "scheduledPayDate"
      ]
    },
    "PayoutItemPageDto": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/PayoutItemDto"
          }
        },
        "page": {
          "type": "integer",
          "format": "int32"
        },
        "size": {
          "type": "integer",
          "format": "int32"
        },
        "totalElements": {
          "type": "integer",
          "format": "int64"
        },
        "totalPages": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "content",
        "page",
        "size",
        "totalElements",
        "totalPages"
      ]
    },
    "SellerPayoutHoldDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "holdCode": {
          "type": "string"
        },
        "payoutId": {
          "type": "integer",
          "format": "int32"
        },
        "payoutCode": {
          "type": "string"
        },
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "raceName": {
          "type": "string"
        },
        "payoutAmount": {
          "type": "integer",
          "format": "int64"
        },
        "reasonType": {
          "$ref": "#/components/schemas/PayoutHoldReason"
        },
        "reason": {
          "type": "string",
          "nullable": true
        },
        "status": {
          "$ref": "#/components/schemas/PayoutHoldStatus"
        },
        "heldAt": {
          "type": "string",
          "format": "date-time"
        },
        "releasedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        }
      },
      "required": [
        "id",
        "holdCode",
        "payoutId",
        "payoutCode",
        "raceId",
        "raceName",
        "payoutAmount",
        "reasonType",
        "status",
        "heldAt"
      ]
    },
    "PayoutHoldDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "holdCode": {
          "type": "string"
        },
        "payoutId": {
          "type": "integer",
          "format": "int32"
        },
        "reasonType": {
          "$ref": "#/components/schemas/PayoutHoldReason"
        },
        "reason": {
          "type": "string",
          "nullable": true
        },
        "status": {
          "$ref": "#/components/schemas/PayoutHoldStatus"
        },
        "heldBy": {
          "type": "integer",
          "format": "int32"
        },
        "heldAt": {
          "type": "string",
          "format": "date-time"
        },
        "releasedBy": {
          "type": "integer",
          "format": "int32",
          "nullable": true
        },
        "releasedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        }
      },
      "required": [
        "id",
        "holdCode",
        "payoutId",
        "reasonType",
        "status",
        "heldBy",
        "heldAt"
      ]
    },
    "PayoutStatus": {
      "type": "string",
      "enum": [
        "지급_예정",
        "지급보류",
        "지급_중",
        "지급_완료",
        "취소"
      ],
      "description": "정산 상태 (지급_예정: 지급 예정, 지급보류: 지급보류, 지급_중: 지급 중, 지급_완료: 지급 완료, 취소: 취소)"
    },
    "PayoutHoldStatus": {
      "type": "string",
      "enum": [
        "지급보류",
        "해제"
      ],
      "description": "지급보류 상태 (지급보류: 지급보류, 해제: 해제)"
    },
    "PayoutHoldReason": {
      "type": "string",
      "enum": [
        "정산_계좌_미등록",
        "대회_취소_처리",
        "대사_불일치"
      ],
      "description": "보류 사유 (정산_계좌_미등록: 정산 계좌 미등록, 대회_취소_처리: 대회 취소 처리, 대사_불일치: 대사 불일치)"
    },
    "PayoutRecordType": {
      "type": "string",
      "enum": [
        "선금",
        "판매",
        "수수료",
        "선지급_차감",
        "회수_요청",
        "갚을_돈_추가",
        "회수_상계",
        "회수_입금",
        "선금_취소",
        "판매_취소",
        "수수료_취소",
        "선지급_차감_취소",
        "회수_상계_취소"
      ],
      "description": "원장 줄 종류 (선금: 선금, 판매: 판매, 수수료: 수수료, 선지급_차감: 선지급 차감, 회수_요청: 회수 요청, 갚을_돈_추가: 갚을 돈 추가, 회수_상계: 회수 상계, 회수_입금: 회수 입금, 선금_취소: 선금 취소, 판매_취소: 판매 취소, 수수료_취소: 수수료 취소, 선지급_차감_취소: 선지급 차감 취소, 회수_상계_취소: 회수 상계 취소)"
    },
    "PayoutStage": {
      "type": "string",
      "enum": [
        "일차_정산",
        "최종_정산"
      ],
      "description": "정산 단계 (일차_정산: 1차 정산, 최종_정산: 최종 정산)"
    }
  }
}
