          "format": "date",
          "description": "다음 정산일. 지급 예정 정산 내역이 없으면 null"
        },
        "scheduledPayoutAmount": {
          "type": "integer",
          "format": "int64"
        },
        "heldCount": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "nextPayDate",
        "scheduledPayoutAmount",
        "heldCount"
      ]
    },
    "PayoutDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32"
        },
        "payoutCode": {
          "type": "string"
        },
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "raceName": {
          "type": "string"
        },
        "payoutStage": {
          "$ref": "#/components/schemas/PayoutStage"
        },
        "payoutMonth": {
          "type": "string"
        },
        "salesAmount": {
          "type": "integer",
          "format": "int64"
        },
        "refundAmount": {
          "type": "integer",
          "format": "int64"
        },
        "feeAmount": {
          "type": "integer",
          "format": "int64"
        },
        "advanceDeductionAmount": {
          "type": "integer",
          "format": "int64",
