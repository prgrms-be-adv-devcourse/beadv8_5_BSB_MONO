        "feeAmount": {
          "type": "integer",
          "format": "int64"
        },
        "targetDate": {
          "type": "string",
          "format": "date"
        },
        "payoutId": {
          "type": "integer",
          "format": "int32"
        },
        "payoutCode": {
          "type": "string"
        },
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "raceName": {
          "type": "string"
        },
