        "virtualBankName": {
          "type": "string",
          "nullable": true,
          "description": "판매자가 입금할 가상계좌 은행 이름. 발급 전에는 null"
        },
        "virtualAccountNumber": {
          "type": "string",
          "nullable": true,
          "description": "판매자가 입금할 가상계좌 번호. 발급 전에는 null"
        }
      },
      "required": [
        "id",
        "claimCode",
        "sellerId",
        "raceId",
        "amount",
        "startDate",
        "dueDate",
        "status"
      ]
