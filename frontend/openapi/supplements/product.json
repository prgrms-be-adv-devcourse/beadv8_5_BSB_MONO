  "paths": {
    "/api/v1/product/banners": {
      "get": {
        "tags": [
          "HomeBanner"
        ],
        "operationId": "findHomeBanners",
        "summary": "홈 배너 대회 목록",
        "description": "관리자가 고른 순서대로 지금 홈에 보일 대회만 준다(대회 목록 카드와 같은 모양). 접수 마감·판매 중지·판매 종료·대회 취소된 대회는 뺀다. 대표 이미지를 받지 못하면 imageUrl만 null이다. 백엔드 PR #781(CRU-147)과 같은 계약이다. 백엔드 명세를 받으면 이 항목을 지운다.",
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsDataListRaceSummaryDto"
                },
                "example": {
                  "status": 200,
                  "message": "홈 배너를 조회했습니다.",
                  "data": [
                    {
                      "raceId": 1,
                      "title": "2026 용감한 쿠키RUN in 서울",
                      "location": "서울숲 일대",
                      "regionSido": "서울특별시",
                      "regionSigungu": "성동구",
                      "raceDate": "2026-12-06T08:00:00",
                      "saleStatus": "ON_SALE",
                      "saleOpenDate": "2026-11-20",
                      "crewSaleStartAt": null,
                      "crewSaleEndAt": null,
                      "individualOpenAt": "2026-11-20T09:00:00",
                      "applicationCloseAt": "2026-11-27T18:00:00",
                      "minPrice": 35000,
                      "courses": [
                        {
                          "raceCourseId": 1,
                          "name": "10K",
                          "courseType": "KM_10",
                          "distanceKm": 10,
                          "price": 45000,
                          "status": "OPEN"
                        }
                      ],
                      "imageUrl": null
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/product/admin/banners": {
      "get": {
        "tags": [
          "AdminHomeBanner"
        ],
        "operationId": "findAdminHomeBanners",
        "summary": "관리자 홈 배너 목록",
        "description": "배너로 고른 대회를 순서대로 모두 준다. 홈에 안 보이는 대회는 이유(hiddenReason, hiddenReasonLabel)와 함께 온다. 백엔드 PR #781(CRU-147)과 같은 계약이다. 백엔드 명세를 받으면 이 항목을 지운다.",
        "responses": {
          "200": {
            "description": "성공",
            "content": {
