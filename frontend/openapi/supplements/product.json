{
  "responses": {
    "search": {
      "200": {
        "wrapper": "RsDataRacePageDto",
        "data": {
          "$ref": "#/components/schemas/RacePageDto"
        }
      }
    },
    "suggest": {
      "200": {
        "wrapper": "RsDataRaceSuggestionDto",
        "data": {
          "$ref": "#/components/schemas/RaceSuggestionDto"
        }
      }
    },
    "findRace": {
      "200": {
        "wrapper": "RsDataRaceDetailDto",
        "data": {
          "$ref": "#/components/schemas/RaceDetailDto"
        }
      }
    },
    "register": {
      "201": {
        "wrapper": "RsDataRaceSaveDto",
        "data": {
          "$ref": "#/components/schemas/RaceSaveDto"
        }
      }
    },
    "update": {
      "200": {
        "wrapper": "RsDataRaceSaveDto",
        "data": {
          "$ref": "#/components/schemas/RaceSaveDto"
        }
      }
    },
    "cancel": {
      "200": {
        "wrapper": "RsDataRaceSaveDto",
        "data": {
          "$ref": "#/components/schemas/RaceSaveDto"
        }
      }
    },
    "findMine": {
      "200": {
        "wrapper": "RsDataListSellerRaceDto",
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/SellerRaceDto"
          }
        }
      }
    },
    "findKitOptions": {
      "200": {
        "wrapper": "RsDataKitOptionListDto",
        "data": {
          "$ref": "#/components/schemas/KitOptionListDto"
        }
      }
    },
    "registerKitOptions": {
      "201": {
        "wrapper": "RsDataKitOptionListDto",
        "data": {
          "$ref": "#/components/schemas/KitOptionListDto"
        }
      }
    },
    "updateKitOptions": {
      "200": {
        "wrapper": "RsDataKitOptionListDto",
        "data": {
          "$ref": "#/components/schemas/KitOptionListDto"
        }
      }
    }
  },
  "schemas": {
    "RacePageDto": {
      "type": "object",
      "properties": {
        "races": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/RaceSummaryDto"
          }
        },
        "page": {
          "type": "integer",
          "format": "int32"
        },
        "size": {
          "type": "integer",
          "format": "int32"
        },
        "totalElements": {
          "type": "integer",
          "format": "int64"
        },
        "totalPages": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "RaceSummaryDto": {
      "type": "object",
      "properties": {
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "title": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "regionSido": {
          "type": "string"
        },
        "regionSigungu": {
          "type": "string"
        },
        "raceDate": {
          "type": "string",
          "format": "date-time"
        },
        "saleStatus": {
          "type": "string",
          "enum": [
            "SCHEDULED",
            "ON_SALE",
            "STOPPED",
            "CLOSED",
            "CANCELED"
          ]
        },
        "saleOpenDate": {
          "type": "string",
          "format": "date"
        },
        "crewSaleStartAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "crewSaleEndAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "individualOpenAt": {
          "type": "string",
          "format": "date-time"
        },
        "applicationCloseAt": {
          "type": "string",
          "format": "date-time"
        },
        "minPrice": {
          "type": "integer",
          "format": "int32"
        },
        "courses": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/RaceSummaryCourseDto"
          }
        }
      }
    },
    "RaceSummaryCourseDto": {
      "type": "object",
      "properties": {
        "raceCourseId": {
          "type": "integer",
          "format": "int32"
        },
        "name": {
          "type": "string"
        },
        "courseType": {
          "type": "string",
          "enum": [
            "KM_5",
            "KM_10",
            "HALF",
            "FULL",
            "ULTRA"
          ]
        },
        "distanceKm": {
          "type": "number"
        },
        "price": {
          "type": "integer",
          "format": "int32"
        },
        "status": {
          "type": "string",
          "enum": [
            "OPEN",
            "SOLD_OUT"
          ]
        },
        "individualRemaining": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "RaceSuggestionDto": {
      "type": "object",
      "properties": {
        "races": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/RaceTitleSuggestionDto"
          }
        },
        "courses": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/CourseLabelSuggestionDto"
          }
        }
      }
    },
    "RaceTitleSuggestionDto": {
      "type": "object",
      "properties": {
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "CourseLabelSuggestionDto": {
      "type": "object",
      "properties": {
        "raceCourseId": {
          "type": "integer",
          "format": "int32"
        },
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "RaceDetailDto": {
      "type": "object",
      "properties": {
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": "string"
        },
        "regionSido": {
          "type": "string"
        },
        "regionSigungu": {
          "type": "string"
        },
        "raceDate": {
          "type": "string",
          "format": "date-time"
        },
        "saleStatus": {
          "type": "string",
          "enum": [
            "SCHEDULED",
            "ON_SALE",
            "STOPPED",
            "CLOSED",
            "CANCELED"
          ]
        },
        "saleOpenDate": {
          "type": "string",
          "format": "date"
        },
        "crewSaleStartAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "crewSaleEndAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "individualOpenAt": {
          "type": "string",
          "format": "date-time"
        },
        "applicationCloseAt": {
          "type": "string",
          "format": "date-time"
        },
        "refundDeadline": {
          "type": "string",
          "format": "date"
        },
        "refundPolicy": {
          "type": [
            "string",
            "null"
          ]
        },
        "crewMinCount": {
          "type": "integer",
          "format": "int32"
        },
        "crewMaxCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "scheduleChangedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "seller": {
          "$ref": "#/components/schemas/RaceSellerDto"
        },
        "courses": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/RaceDetailCourseDto"
          }
        }
      }
    },
    "RaceDetailCourseDto": {
      "type": "object",
      "properties": {
        "raceCourseId": {
          "type": "integer",
          "format": "int32"
        },
        "name": {
          "type": "string"
        },
        "courseType": {
          "type": "string",
          "enum": [
            "KM_5",
            "KM_10",
            "HALF",
            "FULL",
            "ULTRA"
          ]
        },
        "surface": {
          "type": "string",
          "enum": [
            "ROAD",
            "TRAIL"
          ]
        },
        "distanceKm": {
          "type": "number"
        },
        "timeLimitMinutes": {
          "type": "integer",
          "format": "int32"
        },
        "minAge": {
          "type": "integer",
          "format": "int32"
        },
        "maxAge": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "price": {
          "type": "integer",
          "format": "int32"
        },
        "kitIncluded": {
          "type": "boolean"
        },
        "kitPrice": {
          "type": "integer",
          "format": "int32"
        },
        "tshirtSizeOption": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "XS",
              "S",
              "M",
              "L",
              "XL",
              "XXL",
              "XXXL"
            ]
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "OPEN",
            "SOLD_OUT"
          ]
        },
        "crewQuota": {
          "type": "integer",
          "format": "int32"
        },
        "individualQuota": {
          "type": "integer",
          "format": "int32"
        },
        "crewRemaining": {
          "type": "integer",
          "format": "int32"
        },
        "individualRemaining": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "RaceSellerDto": {
      "type": "object",
      "properties": {
        "sellerId": {
          "type": "integer",
          "format": "int32"
        },
        "sellerType": {
          "type": "string",
          "enum": [
            "BUSINESS",
            "INDIVIDUAL"
          ]
        },
        "businessName": {
          "type": [
            "string",
            "null"
          ]
        },
        "businessNumber": {
          "type": [
            "string",
            "null"
          ]
        },
        "representativeName": {
          "type": "string"
        }
      }
    },
    "RaceSaveDto": {
      "type": "object",
      "properties": {
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "saleStatus": {
          "type": "string",
          "enum": [
            "SCHEDULED",
            "ON_SALE",
            "STOPPED",
            "CLOSED",
            "CANCELED"
          ]
        },
        "saleOpenDate": {
          "type": "string",
          "format": "date"
        },
        "courseIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    },
    "SellerRaceDto": {
      "type": "object",
      "properties": {
        "raceId": {
          "type": "integer",
          "format": "int32"
        },
        "title": {
          "type": "string"
        },
        "raceDate": {
          "type": "string",
          "format": "date-time"
        },
        "saleStatus": {
          "type": "string",
          "enum": [
            "SCHEDULED",
            "ON_SALE",
            "STOPPED",
            "CLOSED",
            "CANCELED"
          ]
        },
        "saleOpenDate": {
          "type": "string",
          "format": "date"
        },
        "applicationCloseAt": {
          "type": "string",
          "format": "date-time"
        },
        "courses": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/SellerRaceCourseDto"
          }
        }
      }
    },
    "SellerRaceCourseDto": {
      "type": "object",
      "properties": {
        "raceCourseId": {
          "type": "integer",
          "format": "int32"
        },
        "name": {
          "type": "string"
        },
        "price": {
          "type": "integer",
          "format": "int32"
        },
        "status": {
          "type": "string",
          "enum": [
            "OPEN",
            "SOLD_OUT"
          ]
        },
        "quota": {
          "type": "integer",
          "format": "int32"
        },
        "reserved": {
          "type": "integer",
          "format": "int32"
        },
        "sold": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "KitOptionListDto": {
      "type": "object",
      "description": "대회의 키트 옵션 목록 (등록·수정·조회가 같은 모양)",
      "required": [
        "raceId",
        "kitOptions"
      ],
      "properties": {
        "raceId": {
          "type": "integer",
          "format": "int64"
        },
        "kitOptions": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/KitOptionGroupDto"
          }
        }
      }
    },
    "KitOptionGroupDto": {
      "type": "object",
      "description": "이름이 같은 옵션 묶음. 구매자는 values 중 하나를 고른다",
      "required": [
        "name",
        "values"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/KitOptionValueDto"
          }
        }
      }
    },
    "KitOptionValueDto": {
      "type": "object",
      "required": [
        "kitOptionId",
        "value"
      ],
      "properties": {
        "kitOptionId": {
          "type": "integer",
          "format": "int64"
        },
        "value": {
          "type": "string"
        },
        "stock": {
          "type": "integer",
          "format": "int32",
          "nullable": true,
          "description": "준비 수량. null이면 맞춤 제작이라 품절 없음"
        }
      }
    }
  }
}
