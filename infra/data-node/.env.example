# 보조 EC2 compose 값 (compose.data.yml이 읽는다). 서버에서 이 파일을 .env로 복사해 채운다
#   cp infra/data-node/.env.example infra/data-node/.env && chmod 600 infra/data-node/.env
# .env는 git에 올라가지 않는다. 비밀번호는 채팅·문서에 붙이지 않는다
#
# 비워 두면 compose가 시작하지 않고 어떤 값이 없는지 알려 준다 (${...:?})

# 포트를 열 주소. 이 서버의 사설 IP만 쓰고, 0.0.0.0은 쓰지 않는다
DATA_NODE_BIND_IP=10.0.2.222

# MySQL 계정. 볼륨을 처음 만들 때만 쓰인다 (이미 데이터가 있으면 바꿔도 반영되지 않는다)
# MYSQL_USER·MYSQL_PASSWORD는 앱 Secret(Parameter Store /crewrun/prod/MYSQL_USER·MYSQL_PASS)과 같은 값으로 둔다
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# mysqld-exporter 전용 계정(exporter)의 비밀번호 (BUK-257). openssl rand -hex 24 로 만든다
# 계정은 exporter-user.sql로 한 번 만든다. 이 값을 바꾸면 exporter-user.sql을 다시 실행한다
MYSQL_EXPORTER_PASSWORD=
