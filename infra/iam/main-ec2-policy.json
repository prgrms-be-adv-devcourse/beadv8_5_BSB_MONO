{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCrewrunParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:ap-northeast-2:823315816237:parameter/crewrun/prod",
        "arn:aws:ssm:ap-northeast-2:823315816237:parameter/crewrun/prod/*",
        "arn:aws:ssm:ap-northeast-2:823315816237:parameter/crewrun/registry/*"
      ]
    },
    {
      "Sid": "DecryptViaParameterStoreOnly",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:ap-northeast-2:823315816237:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.ap-northeast-2.amazonaws.com"
        }
      }
    }
  ]
}
