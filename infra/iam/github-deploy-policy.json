{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunShellOnCrewrunServersOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:ap-northeast-2::document/AWS-RunShellScript",
        "arn:aws:ec2:ap-northeast-2:823315816237:instance/<MAIN_INSTANCE_ID>",
        "arn:aws:ec2:ap-northeast-2:823315816237:instance/<DATA_INSTANCE_ID>"
      ]
    },
    {
      "Sid": "ReadCommandResult",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations"
      ],
      "Resource": "*"
    }
  ]
}
