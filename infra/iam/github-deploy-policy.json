{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunShellOnCrewrunServersOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:ap-northeast-2::document/AWS-RunShellScript",
        "arn:aws:ec2:ap-northeast-2:823315816237:instance/i-023cc413eb75c4186",
        "arn:aws:ec2:ap-northeast-2:823315816237:instance/i-07e5410c1d2dffc0d"
      ]
    },
    {
      "Sid": "ReadCommandResult",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations"
      ],
      "Resource": "*"
    }
  ]
}
