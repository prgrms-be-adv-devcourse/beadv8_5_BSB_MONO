{
  "uid": "crewrun-cash",
  "title": "예치금(cash)",
  "tags": [
    "cash"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "결제 API 응답 시간 p95",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{uri}}",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"cash-service\", uri=~\"/internal/v1/cash/payments.*\"}[1m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "응답 상태별 요청 수 (초당)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{status}}",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"cash-service\"}[1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "DB 연결 (사용 중·대기 중, 최대 10)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "사용 중",
          "expr": "hikaricp_connections_active{application=\"cash-service\"}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "대기 중",
          "expr": "hikaricp_connections_pending{application=\"cash-service\"}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "MySQL 락 대기 (초당 횟수·평균 대기 ms)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "초당 대기 횟수",
          "expr": "rate(mysql_global_status_innodb_row_lock_waits[1m])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "평균 대기 ms",
          "expr": "rate(mysql_global_status_innodb_row_lock_time[1m]) / rate(mysql_global_status_innodb_row_lock_waits[1m])"
        }
      ]
    },
    {
      "type": "stat",
      "title": "멈춰 있는 돈 (건)",
      "description": "0이 아니면 사람이 볼 건이에요. 단, recovery_unsent(입금됐지만 정산에 아직 알리지 않음)는 입금 직후 알리기 전까지 잠깐 1 이상이 되는 게 정상이에요. 계속 남아 있을 때만 이상이에요. cash가 여러 대면 서버마다 같은 DB를 세므로 종류별 최댓값으로 묶어요.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{kind}}",
          "expr": "max by (kind) (cash_stuck_money)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "재확인 마지막 성공 뒤 지난 시간",
      "description": "재확인 주기(1분)보다 크게 벌어지면 배치가 실패하거나 돌지 않는 거예요. 서버를 띄운 뒤 한 번도 성공하지 못하면 서버 시작 뒤 지난 시간이 보여요. cash가 여러 대면 분산 락을 잡은 서버만 돌아서 단계별 최댓값으로 묶어요.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{step}}",
          "expr": "time() - max by (step) (cash_reconcile_last_success)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "재확인 실패 (1시간)",
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{step}}",
          "expr": "sum by (step) (increase(cash_reconcile_failures_total[1h]))"
        }
      ]
    }
  ]
}