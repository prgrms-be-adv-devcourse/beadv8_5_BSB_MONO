<!-- LokiLogbackAppenderAutoConfiguration이 Boot가 만든 Logback 설정 위에 더한다 (콘솔 출력은 그대로 둔다) -->
<!-- ${LOKI_URL}·${LOKI_PASSWORD}는 환경변수, ${LOKI_SERVICE}는 자동 설정이 spring.application.name으로 채운다 -->
<configuration>
	<appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
		<!-- DEBUG·TRACE는 보내지 않는다 -->
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>INFO</level>
		</filter>
		<http>
			<url>${LOKI_URL}</url>
			<auth>
				<username>alloy</username>
				<password>${LOKI_PASSWORD}</password>
			</auth>
			<connectionTimeoutMs>5000</connectionTimeoutMs>
		</http>
		<!-- 라벨은 값 종류가 적은 것만 둔다. 요청 번호(MDC requestId)·로거·스레드는 기본 구조화 메타데이터로 간다 -->
		<labels>
			namespace=crewrun
			service=${LOKI_SERVICE}
			env=prod
			level=%level
		</labels>
		<!-- loki4j 기본 형식. 적지 않으면 시작할 때 경고가 찍힌다. 레벨은 라벨, 예외 스택은 PatternLayout이 스스로 붙인다 -->
		<message>
			<pattern>[%thread] %logger{20} - %msg%n</pattern>
		</message>
		<!-- 5초마다(또는 500줄·512KB가 차면) 따로 도는 스레드가 모아 보낸다. 앱 스레드는 큐에 넣기만 한다 -->
		<!-- Loki가 멈추면 보내지 못한 로그가 4MB까지만 쌓이고, 그 뒤 로그는 버린다 (Pod 메모리 상한 512Mi) -->
		<batch>
			<maxItems>500</maxItems>
			<maxBytes>524288</maxBytes>
			<timeoutMs>5000</timeoutMs>
			<sendQueueMaxBytes>4194304</sendQueueMaxBytes>
		</batch>
	</appender>
	<root>
		<appender-ref ref="LOKI"/>
	</root>
</configuration>
