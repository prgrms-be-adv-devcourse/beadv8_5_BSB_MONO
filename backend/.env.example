# 민감정보 암호화 (crypto.enabled: true로 켠 모든 서비스가 같은 키를 쓴다. 지금은 member-service, cash-service)
## openssl rand -base64 32 (휴대폰 번호 등 조회용 블라인드 인덱스 키, 다른 키와 다른 값)
CRYPTO_HMAC_KEY=
## openssl rand -base64 32
CRYPTO_PASSWORD=
## openssl rand -hex 8
CRYPTO_SALT=

# 카카오·구글 소셜 로그인 (member-service, BE-031). 키는 각 개발자 콘솔에서 발급한다. 비우면 그 제공자는 꺼진다
## 콜백 주소 앞부분. 제공자 앱에 <이 값>/api/v1/auth/oauth2/callback/kakao, .../google을 등록한다 (비우면 http://localhost)
OAUTH2_REDIRECT_BASE_URL=
## 콜백 뒤 보낼 프론트 주소 앞부분. Nginx로 프론트와 API가 같은 도메인이면 비운다
OAUTH2_FRONT_BASE_URL=
OAUTH2_KAKAO_CLIENT_ID=
OAUTH2_KAKAO_CLIENT_SECRET=
## 탈퇴·연결 해제 때 카카오 연결 끊기에 쓰는 어드민 키 (비우면 연결 끊기를 건너뛴다)
OAUTH2_KAKAO_ADMIN_KEY=
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=

# 아래 접속 정보는 compose.yml의 앱 컨테이너(member-service, cash-service, file-service, order-service, product-service, queue-service) 기준 (Docker 내부 서비스 이름 사용)
# 실제 운영 서버에 배포할 때는 운영 인프라 주소로 바꾼다

# DB 정보 (compose의 bukang-db와 동일). 아래 값은 로컬 compose용이고, 서버(EC2)에서는 바꾼다
MYSQL_HOST=bukang-db
MYSQL_PORT=3306
MYSQL_USER=bukang2
MYSQL_PASS=bukang2
MYSQL_DB=bukang-db

# cash·payout·file·order·product가 표를 만드는 방법 (compose.yml의 x-jpa-ddl-auto). 비우면 update
# 이 다섯 서비스는 아직 Flyway가 없어 빈 DB에서는 update여야 뜬다. member-service는 Flyway를 쓰므로 이 값과 상관없다
#JPA_DDL_AUTO=update

# Kafka (컨테이너용 internal 리스너)
KAFKA_BOOTSTRAP_SERVERS=bukang-kafka:29092

# Kafka 처리 실패 알림 (product·queue·file, BUK-49). 메시지가 재시도를 모두 실패해 DLT로 오면 이 Slack Incoming Webhook으로 알린다
# 비우면 알림 없이 로그만 남긴다. 주소를 아는 사람은 누구나 채널에 글을 쓸 수 있으니 커밋하거나 채팅에 붙이지 않는다
SLACK_WEBHOOK_URL=

#elasticsearch (로컬은 보안 비활성화라 계정 없음)
ELASTICSEARCH_URIS=http://bukang-elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Redis
REDIS_HOST=bukang-redis
REDIS_PORT=6379

# JWT 서명 키 (32자 이상, openssl rand -base64 32)
JWT_SECRET=

# Toss페이먼츠 결제 승인 (cash-service, PRO-81). 운영용 시크릿 키(live_sk_로 시작)
# 비워도 앱은 뜨지만 결제 승인이 실패한다. 로컬 확인은 테스트 키(test_sk_로 시작)를 넣는다
TOSS_SECRET_KEY=

# 가입 본인인증 (member-service, BUK-33). 포트원 V2 + KG이니시스 통합인증
# 포트원 관리자 콘솔의 V2 API Secret. 비워도 앱은 뜨지만 본인인증 확인이 503으로 실패한다
PORTONE_API_SECRET=
# 키트 배송 조회 (order-service, BUK-55). Delivery Tracker 콘솔(https://console.tracker.delivery)에서 받은 키
# 비워도 앱은 뜨지만 운영(prod)의 배송 조회가 실패한다. 로컬(dev)은 가짜 조회라 비워도 된다
DELIVERY_TRACKER_CLIENT_ID=
DELIVERY_TRACKER_CLIENT_SECRET=
# 포트원 상점 아이디 (store-로 시작). 프론트 NEXT_PUBLIC_PORTONE_STORE_ID와 같은 값
PORTONE_STORE_ID=
# CI(개인 고유 식별키)를 해시할 때 섞는 비밀 키 (openssl rand -base64 32). 바꾸면 기존 회원과 같은 사람인지 비교할 수 없다
IDENTITY_CI_HASH_KEY=

# CRM 광고 수신 거부 링크 서명 키 (member-service, BUK-75) (openssl rand -base64 32, 32바이트 이상)
# 비우거나 짧으면 링크 발급과 수신 거부가 실패한다. 링크 앞부분은 아래 FRONT_PUBLIC_BASE_URL을 쓰므로 운영은 그 값도 꼭 넣는다. 바꾸면 이미 보낸 메시지의 수신 거부 링크가 모두 쓸 수 없게 된다
MARKETING_UNSUBSCRIBE_KEY=

# 비밀번호 재설정 메일 (member-service, BUK-40). 크루런 전용 Gmail 계정의 SMTP로 보낸다
# MAIL_HOST를 비우면 메일을 보내지 않는다. 로컬(dev)은 재설정 링크를 로그에 찍고, 운영(prod)은 경고만 남긴다
# 로컬 가짜 메일 서버(Mailpit) 예: MAIL_HOST=localhost, MAIL_PORT=1025, MAIL_SMTP_STARTTLS=false, MAIL_USERNAME·MAIL_PASSWORD는 비움
# SMTP 서버 주소 (Gmail은 smtp.gmail.com)
MAIL_HOST=
# SMTP 포트. 기본 587(STARTTLS). 빈 값으로 두면 기본값이 쓰이지 않으므로 바꿀 때만 주석을 푼다
#MAIL_PORT=587
# STARTTLS(전송 암호화). 기본 true. Gmail은 꼭 켜야 하므로 암호화를 지원하지 않는 로컬 메일 서버에서만 주석을 풀고 false로 둔다
#MAIL_SMTP_STARTTLS=false
# 전용 Gmail 주소. 보내는 주소로도 쓴다. 비우면 SMTP 인증 없이 보낸다
MAIL_USERNAME=
# 그 계정의 앱 비밀번호 16자리 (Google 계정 비밀번호가 아니다). 계정 비밀번호를 바꾸면 폐기되므로 새로 만들어 넣는다
MAIL_PASSWORD=
# 메일 링크 앞부분. 운영은 주석을 풀고 크루런 공개 주소(https://로 시작)를 넣는다. 없으면 운영 메일 링크가 열리지 않는다
# 로컬은 주석으로 두면 http://localhost:3000을 쓴다
#FRONT_PUBLIC_BASE_URL=

# 파일 저장소 S3 (file-service)
# 아래 값이 없으면 로컬 S3Mock을 쓴다 (bootRun은 localhost:9090, compose 앱 컨테이너는 bukang-s3mock:9090)
# 실제 AWS S3를 쓰려면 아래 7줄의 주석을 모두 풀고 값을 채운다
# 값이 빈 S3_ENDPOINT·S3_PUBLIC_ENDPOINT도 반드시 주석을 푼다. 주석으로 남기면 S3Mock 주소가 쓰여 버킷을 찾지 못한다
# 키는 로컬 확인용 IAM 사용자 키다. 운영 서버(EC2)에서는 키 대신 IAM 역할을 쓰고 두 키를 빈 값으로 둔다
#S3_BUCKET=
#AWS_REGION=ap-northeast-2
#S3_ENDPOINT=
#S3_PUBLIC_ENDPOINT=
#S3_PATH_STYLE=false
#S3_ACCESS_KEY=
#S3_SECRET_KEY=

# 프론트(web 컨테이너). compose.yml이 이 파일에서 읽는다 (프론트 설명은 frontend/.env.example)
# 아래 값은 빌드할 때 이미지에 고정되므로 바꾸면 docker compose --profile app up -d --build web 으로 다시 빌드한다
# 운영 CD 빌드(app-cd.yml)는 이 파일이 아니라 저장소 Variables(Settings → Secrets and variables → Actions → Variables)에서 SITE_URL·NEXT_PUBLIC_TOSS_CLIENT_KEY·IMAGE_REMOTE_HOSTS·NEXT_PUBLIC_PORTONE_*를 읽는다
## next/image가 최적화를 허용할 이미지 호스트(https만, 쉼표 구분). 실제 S3를 쓰면 버킷 도메인 (예: bukang-file.s3.ap-northeast-2.amazonaws.com)
#IMAGE_REMOTE_HOSTS=
## 설정하면 next/image가 이 CDN 주소로 이미지를 요청한다
#NEXT_PUBLIC_IMAGE_CDN_URL=
## 공유 카드(og:image)의 절대 주소. 비우면 http://localhost (빌드와 실행에 같은 값을 넘긴다)
#SITE_URL=
## 토스 결제창 클라이언트 키. 테스트 키(test_ck_)만 쓴다. TOSS_SECRET_KEY와 같은 상점 키여야 한다
#NEXT_PUBLIC_TOSS_CLIENT_KEY=
## 포트원 본인인증 상점 아이디와 채널 키 (BUK-33). 상점 아이디는 PORTONE_STORE_ID와 같은 값
#NEXT_PUBLIC_PORTONE_STORE_ID=
#NEXT_PUBLIC_PORTONE_IDENTITY_CHANNEL_KEY=
## 어드민 이용 통계의 GA4 연결 정보. 실행할 때 읽으므로 web 컨테이너만 다시 띄우면 된다(다시 빌드하지 않는다). 운영은 서버의 이 파일에 넣는다
## GA4 속성 ID(숫자, G-로 시작하는 측정 ID가 아님)와 서비스 계정 키 JSON을 base64로 바꾼 한 줄
#GA4_PROPERTY_ID=
#GA4_SERVICE_ACCOUNT_KEY=

# 운영(EC2) HTTPS. 로컬에서는 모두 비워 둔다 (compose.prod.yml 참고)
# 아래 네 줄을 채우면 앱 이미지는 GitHub Actions(app-cd.yml)가 GHCR에서 받아 띄우고, Let's Encrypt 인증서는 certbot이 받는다
## compose.prod.yml을 덧붙이고 앱 컨테이너(profile app)까지 띄운다. 매번 -f, --profile을 붙이지 않아도 된다
## COMPOSE_FILE을 쓰면 compose.override.yml을 자동으로 읽지 않는다. 서버에 override 파일이 있으면 가운데에 함께 적는다
##   예: COMPOSE_FILE=compose.yml:compose.override.yml:compose.prod.yml
#COMPOSE_FILE=compose.yml:compose.prod.yml
#COMPOSE_PROFILES=app
## 인증서를 받을 도메인. A 레코드가 이 서버(탄력적 IP)를 가리키고, 보안 그룹에서 80·443이 열려 있어야 한다
#DOMAIN=crewrun.duckdns.org
## Let's Encrypt 계정 이메일 (약관·계정 관련 공지를 받는다. 만료 알림 메일은 2025년부터 보내지 않는다)
## 바꾸려면 이 값만 고치고 docker compose up -d certbot 으로 다시 띄운다 (시작할 때 계정 이메일을 맞춘다)
#CERTBOT_EMAIL=
## HTTPS로 바꾸면 위 SITE_URL도 https://도메인 으로 바꾼다
